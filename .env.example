# ---------------------------------------------------------------------------
# Nexyronix — environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Nothing in here is read by the browser bundle: these are server-side only.
# (Vite only exposes variables prefixed with VITE_ to the client — none of the
# secrets below use that prefix, which is deliberate.)
# ---------------------------------------------------------------------------

# --- Enquiry delivery (required for the contact form to work) --------------
# Where enquiry notifications are sent. Not a secret — safe to commit as-is.
CONTACT_EMAIL=info@nexyronix.com

# Sent via the Resend HTTPS API, not SMTP — Railway blocks outbound SMTP
# (ports 25/465/587/2525) on every plan below Pro, confirmed by testing two
# different providers from this exact deployment (both failed identically
# with a connection timeout). An HTTPS API call isn't affected by that block.
# Get a key at resend.com/api-keys (requires a verified sending domain).
RESEND_API_KEY=

# The From address. Must be on a domain Resend has verified for you, or
# sending will be rejected. Var name kept from the earlier SMTP-based setup.
SMTP_FROM=

# --- Optional enquiry storage ----------------------------------------------
# Leave blank to skip persistence entirely (email still works).
DATABASE_URL=

# --- Public contact details (optional overrides) ---------------------------
# These ARE sent to the browser, hence the VITE_ prefix. Put nothing sensitive
# here. Real defaults (info@nexyronix.com, +91 94820 81830, the office
# address) are already baked into src/data/site.ts, so these only need to be
# set if you want to override them for a specific environment.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_LOCATION=

# --- Deployment ------------------------------------------------------------
# Canonical origin used for canonical tags, Open Graph URLs and the sitemap.
# Defaults to https://nexyronix.com when unset.
VITE_SITE_URL=

# Injected automatically by Railway — do not set manually in production.
PORT=3000
