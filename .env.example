# ---------------------------------------------------------------------------
# Nexyronix — environment configuration
#
# Copy to `.env` for local use and fill in real values. NEVER commit `.env`.
# In production, set these as App Settings on the Azure App Service (secrets
# as Key Vault references) — never in the repository.
#
# Two kinds of variable live here:
#   RUNTIME     read by the Node server while it runs (server/, api/).
#   BUILD-TIME  VITE_* values, baked into the browser bundle by `vite build`.
#               Setting them on the running host has no effect — they must be
#               present wherever `npm run build` runs (e.g. the CI workflow).
# Vite only exposes VITE_-prefixed variables to the browser; none of the
# secrets below use that prefix, which is deliberate.
# ---------------------------------------------------------------------------

# --- Enquiry delivery (RUNTIME, required for the contact form) ------------
# Where enquiry notifications are sent. Not a secret.
CONTACT_EMAIL=info@nexyronix.com

# SECRET. Resend API key — sent via Resend's HTTPS API, not SMTP, so it works
# on hosts that restrict outbound SMTP ports. Use a "Sending access" key
# scoped to the verified domain. Get one at resend.com/api-keys.
# On Azure, store it in Key Vault and reference it from App Settings.
RESEND_API_KEY=

# The From address, e.g. "Nexyronix <noreply@nexyronix.com>". Must be on a
# domain verified in Resend, or sending is rejected. (The name is kept from
# the earlier SMTP-based version so existing deployments need no rename.)
SMTP_FROM=

# --- Hosting (RUNTIME, optional) --------------------------------------------
# Hostname every other host should 301-redirect to: www.nexyronix.com (the
# bare domain, *.azurewebsites.net, anything else). Leave EMPTY until
# www.nexyronix.com is bound to this deployment — otherwise pre-cutover testing
# on the platform hostname redirects away. NEVER set it to the bare domain
# nexyronix.com: that domain only forwards to www, so the two would redirect
# to each other forever. /api/health is never redirected.
CANONICAL_HOST=

# Number of proxies in front of the app that append to X-Forwarded-For; used
# to find the real client IP for rate limiting. 1 = App Service on its own
# (default). 2 = e.g. Azure Front Door in front of App Service.
TRUST_PROXY_HOPS=1

# Recommended in production (Express uses it). Do NOT set it where
# `npm ci && npm run build` runs, or devDependencies are skipped and the build
# fails.
NODE_ENV=

# Injected by Azure App Service. Do not set it there; only useful locally.
PORT=3000

# --- Enquiry storage (NOT IMPLEMENTED) --------------------------------------
# There is no database. storeEnquiry() in api/contact.ts is a documented
# no-op hook, and setting DATABASE_URL does nothing. Leave unset.
# DATABASE_URL=

# --- Public contact details (BUILD-TIME, optional overrides) ----------------
# These ARE shipped to the browser, hence the VITE_ prefix. Put nothing
# sensitive here. Real defaults (info@nexyronix.com, +91 94820 81830, the
# office address) are already in src/data/site.ts, so set these only to
# override them for a specific build.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_LOCATION=

# VITE_SITE_URL is declared (src/vite-env.d.ts, src/data/site.ts) but nothing
# currently reads it: canonical, Open Graph, sitemap and robots URLs are
# hard-coded to https://www.nexyronix.com in index.html, public/sitemap.xml,
# public/robots.txt and the legal pages. Edit those files to change domain.
VITE_SITE_URL=
